# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to GitHub — it's already in .gitignore.

# Where the SQLite database file will be created
DATABASE_URL=sqlite:///./app.db

# A random secret string used to sign login tokens (JWT).
# Generate one yourself, e.g. by running: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-secret-key

# Optional: AI provider API key. Leave empty to run in DEMO MODE
# (the app will use realistic sample/mock AI output instead of calling a real API).
AI_API_KEY=

# When true (or when AI_API_KEY is empty), AI features run in demo/mock mode.
DEMO_MODE=true
