# Copy this file to ".env" in the same folder and fill in your own values.
# NEVER commit the real .env file - it is already in .gitignore.

# Where the database file lives. The default is fine for development.
# PRIMARY DATABASE: Supabase (hosted Postgres) - 2026-09-05 onward.
# Get the real password from your Supabase dashboard: open the project
# at supabase.com/dashboard -> Project Settings -> Database -> "Database
# password" (reset it there if you don't remember it), then paste it in
# below in place of [YOUR-PASSWORD]. Never commit the real password.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.cfaoxjakcaxefqpsuozd.supabase.co:5432/postgres
# Fallback for offline/local development without internet - swap the
# line above for this one if you ever need to work fully offline:
# DATABASE_URL=sqlite:///./app.db

# Used to sign login tokens. Generate your own with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# ---------------------------------------------------------------------
# AI (optional - the app works without it, in honest Demo Mode)
# ---------------------------------------------------------------------
# ONE free key powers every AI feature:
#   - AI Photo Studio (re-shoots product photos)
#   - Catalogue generation in Hindi / Hinglish / English
#   - AI Business Manager chat
#
# How to get it (free, takes 2 minutes, no card needed):
#   1. Go to https://aistudio.google.com/apikey
#   2. Sign in with any Google account
#   3. Click "Create API key"
#   4. Paste it below, then restart the backend
AI_API_KEY=

# ---------------------------------------------------------------------
# OpenAI / ChatGPT - the PRIMARY provider (2026-09-05 onward)
# ---------------------------------------------------------------------
# The app now defaults every text feature (Catalogue, AI Business
# Manager, the Dashboard AI Insight card) AND the Photo Studio to
# OpenAI. Get a key + enable billing at
# https://platform.openai.com/api-keys (OpenAI has NO free tier like
# Gemini - you need billing/credit added before this key will work).
OPENAI_API_KEY=

# Which provider each feature uses: "openai" (default now) or "gemini".
# Change independently if you ever want to compare answer quality, or
# flip just one feature back to Gemini.
CATALOGUE_AI_PROVIDER=openai
BUSINESS_ADVICE_AI_PROVIDER=openai

# IMPORTANT SAFETY NET: Gemini (AI_API_KEY above) is kept fully wired
# up as an automatic fallback, not removed. If OPENAI_API_KEY is blank,
# runs out of credit, or hits a rate limit mid-hackathon, every text
# feature and the Photo Studio automatically and silently drop back to
# the free Gemini key instead of breaking or showing an error - keep
# your Gemini key in this file too as insurance, it costs nothing to
# leave it there.

# Leave DEMO_MODE on "auto" - it uses real AI when the relevant key is
# present and switches to Demo Mode when it is not. Set it to "true" to
# force Demo Mode even with a key (useful for practising the demo
# offline, or when at a venue with no internet).
DEMO_MODE=auto

# Only change these if a provider renames its models (both Google and
# OpenAI do this occasionally).
# AI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
# OPENAI_MODEL=gpt-4o-mini
#   ^ the app now defaults to "gpt-5.6-luna" (confirmed available and
#   very cheap - $0.20/1M input, $1.20/1M output). Only uncomment this
#   line to force gpt-4o-mini instead if Luna ever errors on your key.
# OPENAI_IMAGE_MODEL=gpt-image-1
#   ^ same idea - "gpt-image-2" is newer/cheaper per OpenAI's pricing
#   page but confirm your account has access before switching.
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# IMPORTANT: neither Gemini's nor OpenAI's image model has a free tier -
# both need billing/credit enabled on the account behind the key, even
# though the equivalent TEXT models are free (Gemini) or very cheap
# (OpenAI). If AI Photo Studio always falls back to "Basic enhancement
# only", this is the most likely reason - run test_ai.bat and check
# ai_report.txt's "IMAGE TEST" section for the exact error.

# The address the frontend runs on - used to build storefront QR codes.
FRONTEND_URL=http://localhost:5180
