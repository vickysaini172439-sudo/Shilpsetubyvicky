# Build-time configuration for the DEPLOYED frontend.
# Vite automatically loads this file during "npm run build" (production),
# and ignores it during "npm run dev" - so local development still talks
# to the backend on localhost:8010 exactly as before.
#
# This is a public API address, not a secret, so it is safe to commit.
VITE_API_URL=https://shilpsetu-backend.onrender.com
